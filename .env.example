# Переменные окружения для yandex-tracker-mcp в HTTP-режиме (multi-tenant).
#
# Сервер в HTTP-режиме мультитенантный: каждый входящий запрос сам несёт
# личный OAuth-токен пользователя в заголовке "Authorization: OAuth <token>"
# и опционально организацию в заголовке "X-Org-Id" / "X-Cloud-Org-Id".
# Никакого секретного токена доступа к серверу в env хранить не нужно.
#
# Все переменные ниже НЕОБЯЗАТЕЛЬНЫ и используются только как дефолты
# уровня процесса — применяются, если конкретный запрос не передал
# соответствующий заголовок/параметр сам.
#
# ВАЖНО: TRACKER_USERNAME, TRACKER_OAUTH_TOKEN и флаг CLI --auth относятся
# только к локальному stdio-режиму (npx yandex-tracker-mcp на машине
# разработчика для авторизации через браузер) и НЕ используются на сервере
# в HTTP-режиме — не добавляйте их сюда.

# ID организации "Яндекс 360 для бизнеса".
# Укажите ЛИБО эту переменную, ЛИБО TRACKER_CLOUD_ORG_ID (не обе сразу).
TRACKER_ORG_ID=1234567

# ID организации Yandex Cloud Organization (алфавитно-цифровой).
TRACKER_CLOUD_ORG_ID=

# Очередь по умолчанию для search_issues / create_issue, если запрос её не указал.
TRACKER_DEFAULT_QUEUE=MYQUEUE

# Проект по умолчанию (числовой shortId) для search_issues / create_issue / update_issue.
TRACKER_DEFAULT_PROJECT=
